<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅为 System.Windows.Forms.Screen（多屏枚举与物理像素边界）；
         Pulpit.Core 不得引用 WinForms/WPF 类型。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pulpit.App</RootNamespace>
    <AssemblyName>Pulpit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- L14：PerMonitorV2 DPI 感知，防止换屏后副屏字号被系统拉伸 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 教会标志(红十字 + 翻开的圣经),由 docs/logo.png 同源的矢量重绘生成。
         WPF 窗口标题栏与任务栏默认取 exe 图标,无需逐窗口设置 Icon。 -->
    <ApplicationIcon>Assets\pulpit.ico</ApplicationIcon>
    <!-- 版本号是安装版/Portable 版打包的唯一事实来源(tools/package.ps1 从这里读) -->
    <Version>1.2.0</Version>
    <Product>Pulpit</Product>
    <AssemblyTitle>Pulpit — 经文投屏</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulpit.Core\Pulpit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 经文库嵌成资源（M6）。单文件发布时 exe 旁边没有别的文件，而 SQLite 需要
         真实文件路径，所以首次运行由 DatabaseProvisioner 解出到 %LOCALAPPDATA%\Pulpit\。
         LogicalName 显式钉住，不依赖 Link 路径推导出的名字。
         Include 直接引用仓库根那一份，git 里不放第二份 7MB 副本。 -->
    <EmbeddedResource Include="..\..\bible_cuv.db" LogicalName="Pulpit.App.Assets.bible_cuv.db" />
  </ItemGroup>

</Project>
