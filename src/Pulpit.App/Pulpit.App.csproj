<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅为 System.Windows.Forms.Screen（多屏枚举与物理像素边界）；
         Pulpit.Core 不得引用 WinForms/WPF 类型。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Pulpit.App</RootNamespace>
    <AssemblyName>Pulpit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- L14：PerMonitorV2 DPI 感知，防止换屏后副屏字号被系统拉伸 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulpit.Core\Pulpit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 经文库随包。用 Link 引用仓库根的那一份，不在 git 里放第二份 7MB 副本。
         M6 会改成嵌入资源 + 首次运行复制到 %LOCALAPPDATA%\Pulpit\。 -->
    <Content Include="..\..\bible_cuv.db" Link="Assets\bible_cuv.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
