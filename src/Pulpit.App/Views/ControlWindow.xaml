<Window x:Class="Pulpit.App.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulpit — M0 技术尖刺"
        Width="720" Height="760"
        MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei"
        FontSize="13"
        Background="#FFF3F3F3">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,8,10,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 目标屏 -->
        <GroupBox Grid.Row="0" Header="① 目标屏（副屏）">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ScreenList" Grid.Column="0" Height="28"
                          VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="移到此屏" Click="OnMoveToScreen" />
                <Button Grid.Column="2" Content="刷新屏幕列表" Click="OnRefreshScreens" Margin="0" />
            </Grid>
        </GroupBox>

        <!-- ② 投放 -->
        <GroupBox Grid.Row="1" Header="② 投放（M0 无全局热键，一律用鼠标；见下方说明）">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="BodyInput" Grid.Row="0" Grid.Column="0"
                         Text="测试" Height="28" VerticalContentAlignment="Center"
                         Margin="0,0,8,8" />
                <Button Grid.Row="0" Grid.Column="1" Content="应用文字"
                        Click="OnApplyText" Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="淡入 (250ms)" Click="OnFadeIn" />
                    <Button Content="淡出 (250ms)" Click="OnFadeOut" />
                    <Button Content="连续淡入淡出 ×20" Click="OnStressFade" MinWidth="150" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ③ 自检 -->
        <GroupBox Grid.Row="2" Header="③ 实时自检">
            <StackPanel>
                <TextBlock x:Name="StyleReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                <TextBlock x:Name="BandReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                <TextBlock x:Name="FadeReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                <TextBlock x:Name="RuntimeReport" Style="{StaticResource Mono}" />
            </StackPanel>
        </GroupBox>

        <!-- ④ 验收清单 -->
        <GroupBox Grid.Row="3" Header="④ M0 验收清单（9 项，需在真实直播机上逐项确认）">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChecklistPanel" />
            </ScrollViewer>
        </GroupBox>

        <TextBlock x:Name="LogPathText" Grid.Row="4" Style="{StaticResource Mono}"
                   Foreground="#FF666666" FontSize="11" Margin="0,4,0,0" />
    </Grid>
</Window>
