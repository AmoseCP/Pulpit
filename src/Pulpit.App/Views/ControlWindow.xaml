<Window x:Class="Pulpit.App.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulpit — 控制台"
        Width="760" Height="800"
        MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei"
        FontSize="13"
        Background="#FFF3F3F3">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,8,10,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 数据库告警条：仅在经文库打不开时出现 -->
        <Border x:Name="DatabaseWarning" Grid.Row="0" Visibility="Collapsed"
                Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="1"
                Padding="10,7" Margin="0,0,0,10">
            <TextBlock x:Name="DatabaseWarningText" TextWrapping="Wrap" Foreground="#FF5A4500" />
        </Border>

        <!-- ① 投放 -->
        <GroupBox Grid.Row="1" Header="① 投放">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox" Grid.Row="0" Grid.Column="0"
                         Height="30" FontSize="15" VerticalContentAlignment="Center"
                         Margin="0,0,8,6" AcceptsReturn="False" />
                <Button Grid.Row="0" Grid.Column="1" Content="投放" Click="OnSend"
                        Margin="0,0,0,6" MinWidth="96" FontWeight="SemiBold" />

                <TextBlock x:Name="ModeText" Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="0,0,0,8" Foreground="#FF444444" TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="上一页 F7" Click="OnPrevPage" MinWidth="96" />
                    <Button Content="下一页 F8" Click="OnNextPage" MinWidth="96" />
                    <Button Content="清屏 F12" Click="OnClear" MinWidth="96" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ② 样例（M2 验收用） -->
        <GroupBox Grid.Row="2" Header="② 样例（M2 验收：最长节 / 最短内容 / 多页）">
            <StackPanel Orientation="Horizontal">
                <Button Content="申30:9 (106字 全库最长)" Click="OnSample" Tag="申30:9" MinWidth="180" />
                <Button Content="太23:13 (60字)" Click="OnSample" Tag="太23:13" MinWidth="130" />
                <Button Content="诗23:1-6 (6页)" Click="OnSample" Tag="诗23:1-6" MinWidth="130" />
                <Button Content="测试 (2字)" Click="OnSample" Tag="测试" MinWidth="100" Margin="0" />
            </StackPanel>
        </GroupBox>

        <!-- ③ 目标屏 -->
        <GroupBox Grid.Row="3" Header="③ 目标屏（副屏）">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ScreenList" Grid.Column="0" Height="28"
                          VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="移到此屏" Click="OnMoveToScreen" />
                <Button Grid.Column="2" Content="刷新" Click="OnRefreshScreens" Margin="0" />
            </Grid>
        </GroupBox>

        <!-- ④ 自检 -->
        <GroupBox Grid.Row="4" Header="④ 实时自检">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="StyleReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                    <TextBlock x:Name="BandReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                    <TextBlock x:Name="RenderReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                    <TextBlock x:Name="FadeReport" Style="{StaticResource Mono}" Margin="0,0,0,4" />
                    <TextBlock x:Name="RuntimeReport" Style="{StaticResource Mono}" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="StressButton" Content="Show/Clear ×200（验句柄与 Z 序）"
                            Click="OnStress" MinWidth="240" />
                </StackPanel>

                <TextBlock x:Name="StressReport" Grid.Row="2" Style="{StaticResource Mono}"
                           VerticalAlignment="Top" Foreground="#FF225522" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="LogPathText" Grid.Row="5" Style="{StaticResource Mono}"
                   Foreground="#FF666666" FontSize="11" Margin="0,4,0,0" />
    </Grid>
</Window>
