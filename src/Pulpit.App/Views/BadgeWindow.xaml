<Window x:Class="Pulpit.App.Views.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulpit Badge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Grid x:Name="RootLayer" Opacity="0">
        <Border x:Name="BadgeBackground" Background="#8C000000" CornerRadius="4">
            <!--
              这里用 Viewbox 是合适的，与正文不同：
              角标是**单行短文本**，不需要换行，正是 Viewbox 适用的场合。
              正文之所以不能用 Viewbox，是因为它必须换行——Viewbox 给子元素
              无限宽度，TextWrapping 就永不生效（见 OverlayWindow.FitBody 的注释）。
              StretchDirection=DownOnly：短文本保持 BadgeText 的字号，长了才缩。
            -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                     Margin="10,4,10,4"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="BadgeText"
                           Foreground="White"
                           FontSize="48"
                           TextWrapping="NoWrap" />
            </Viewbox>
        </Border>
    </Grid>
</Window>
