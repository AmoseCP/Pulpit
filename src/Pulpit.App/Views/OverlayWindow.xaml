<Window x:Class="Pulpit.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pulpit.App.Views"
        Title="Pulpit Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
      带状区域的结构、主题与字号算法都在 BandView 里——它同时被 ② 主屏预览
      用来渲染「投放前」的内容，两边共用一个类才不会漂移。本窗口只负责
      副屏特有的部分：扩展样式、定位、淡入淡出、内容模型与翻页。

      RootLayer.Opacity 是淡入淡出的唯一动画目标：分层窗口整窗改透明度会让
      整块表面重新提交，元素级动画在带状区域（约 1920×324）上开销更可控。
    -->
    <Grid x:Name="RootLayer" Opacity="0">
        <views:BandView x:Name="BandArea" />
    </Grid>
</Window>
